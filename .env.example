ENVIRONMENT=development
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://crm:replace-with-a-random-database-password@127.0.0.1:54329/crm
SECRET_KEY=replace-with-an-independent-random-secret-at-least-32-characters
